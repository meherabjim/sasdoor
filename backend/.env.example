# PostgreSQL connection (database name: sasdoor)
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/sasdoor?schema=public"

PORT=5000
PUBLIC_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:3000

# Long random text. Anyone holding this can mint an admin token, so treat it like a
# password: never commit it, and change it if it has ever been shared.
# Generate a fresh one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=xg-T3bNjXndofYSxlwdw4O0dXPBmJbnm1RMu4Z9-QUkKqif3ros5dXy6jc340Y2G
JWT_EXPIRES=7d

# Super Admin.
#   `npm run db:seed`   creates this account only if it does not exist yet
#   `npm run set-admin` creates it, or resets the password of the existing one
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=deadlinedodgers30210@gmail.com
SUPER_ADMIN_PASSWORD=SasDoor-RDJ3tF5X14mm0C
SUPER_ADMIN_PHONE=

UPLOAD_DIR=uploads

# ---- SMS (optional) --------------------------------------------------------
# Leave SMS_URL empty and no text is sent — the customer still gets every message
# on their own page under "Updates". Fill these in from your gateway's own docs.
SMS_URL=
SMS_METHOD=GET
SMS_TO_PARAM=to
SMS_TEXT_PARAM=message
SMS_EXTRA=
